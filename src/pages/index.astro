---
// src/pages/index.astro
import { Image } from 'astro:assets'; 
import heroImage from '@/assets/hero-speaking.jpg';

import Layout from '../layouts/Layout.astro';
import BookingWidget from '../components/BookingWidget.astro';
import KeyExpertise from '../components/KeyExpertise.astro';
import SpeakingEngagements from '../components/SpeakingEngagements.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';

const credentials = [
  { name: "Millennium Challenge Corporation", short: "MCC" },
  { name: "Peace Corps Ecuador", short: "Peace Corps" },
  { name: "TechnoServe", short: "TechnoServe" },
  { name: "Harvard Kennedy School", short: "Harvard" },
  { name: "Purdue University", short: "Purdue" }
];

const metrics = [
  { value: "$1.4B+", label: "Sovereign Portfolios Evaluated", sub: "Infrastructure, TVET & Energy at MCC" },
  { value: "25+", label: "Rigorous Causal Evaluations", sub: "Large-Scale RCTs & Econometric Studies" },
  { value: "60+", label: "Global Country Posts", sub: "Integrated via Custom Data Platforms" },
  { value: "4,600+", label: "Schools & Institutions Reached", sub: "Sovereign Evidence Reforms & MEL" },
];
---

<Layout 
  title="Ryan A. Moore | Senior Strategy & Innovation Leader" 
  description="The executive portfolio of Ryan A. Moore: Senior Strategy & Innovation Leader applying AI and data science to solve complex global challenges across international development, economic research, and organizational transformation."
>
  
  <!-- Executive Hero Section -->
  <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
    <!-- Ambient light glow effects -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-gradient-to-tr from-blue-100/50 via-sky-100/30 to-amber-100/20 blur-3xl -z-10 pointer-events-none rounded-full"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Executive Bio & CTAs (7 cols) -->
        <div class="lg:col-span-7 text-center lg:text-left space-y-8" data-animate-on-scroll>
          
          <!-- Status Pill -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50/90 border border-blue-200/70 text-brand-blue text-xs font-semibold tracking-wide uppercase shadow-sm">
            <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
            <span>Global Development &bull; AI &bull; Econometrics</span>
          </div>

          <!-- Main Editorial Headline -->
          <div class="space-y-4">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold text-brand-slate tracking-tight leading-[1.15]">
              Turning complex data into <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue via-blue-600 to-indigo-600">evidence-based global impact</span>.
            </h1>
            <p class="text-lg sm:text-xl text-slate-600 font-normal leading-relaxed max-w-2xl mx-auto lg:mx-0">
              Senior Strategy & Innovation Leader with 20+ years steering multi-million dollar international programs, frontier AI systems, and rigorous econometric evaluations.
            </p>
          </div>

          <!-- Credentials / Affiliations Bar -->
          <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs font-medium text-slate-500">
            <span class="text-slate-400 font-semibold uppercase tracking-wider text-[11px] mr-1">Proven with:</span>
            {credentials.map((cred) => (
              <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-700 shadow-xs font-semibold">
                {cred.short}
              </span>
            ))}
          </div>

          <!-- Action Buttons -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a 
              href="/portfolio" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-brand-blue hover:bg-blue-800 text-white font-semibold shadow-lg shadow-blue-900/20 hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5 group"
            >
              <span>Explore Case Studies</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a 
              href="/cv" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white hover:bg-slate-50 text-slate-800 font-semibold border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5"
            >
              <svg class="w-4 h-4 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>View Full CV</span>
            </a>
          </div>

        </div>

        <!-- Right Column: Visual Portrait with Floating Badges (5 cols) -->
        <div class="lg:col-span-5 relative" data-animate-on-scroll>
          <div class="relative mx-auto max-w-md lg:max-w-none">
            
            <!-- Glow background behind image -->
            <div class="absolute -inset-3 bg-gradient-to-tr from-brand-blue/20 to-indigo-500/20 rounded-3xl blur-2xl opacity-70 transform -rotate-1"></div>
            
            <!-- Image Card Frame -->
            <div class="relative bg-white p-3 rounded-2xl shadow-2xl border border-slate-100 ring-1 ring-black/5 overflow-hidden group">
              <Image 
                src={heroImage} 
                alt="Ryan A. Moore speaking on a panel about international development"
                class="rounded-xl w-full h-[440px] object-cover object-top transition-transform duration-700 group-hover:scale-105"
                priority
              />
              
              <!-- Floating Bottom Glass Badge -->
              <div class="absolute bottom-6 left-6 right-6 glass-panel p-4 rounded-xl shadow-lg border border-white/80">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-brand-accent">Executive Profile</p>
                    <p class="text-sm font-serif font-bold text-brand-slate">Ryan A. Moore</p>
                  </div>
                  <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-100/90 text-emerald-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Available for Strategic Advisory
                  </span>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Impact Metrics Row -->
      <div class="mt-20 pt-10 border-t border-slate-200/80" data-animate-on-scroll>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8">
          {metrics.map((metric) => (
            <div class="glass-panel p-6 rounded-2xl border border-slate-200/60 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-1">
              <p class="text-3xl sm:text-4xl font-serif font-bold text-brand-slate tracking-tight">{metric.value}</p>
              <p class="text-sm font-bold text-brand-blue mt-1">{metric.label}</p>
              <p class="text-xs text-slate-500 mt-0.5">{metric.sub}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Core Pillars / Key Expertise -->
  <KeyExpertise />

  <!-- Featured Projects Gallery -->
  <FeaturedProjects />

  <!-- Speaking & Media -->
  <SpeakingEngagements />

  <!-- Interactive Booking & Contact -->
  <div id="connect">
    <BookingWidget />
  </div>

</Layout>