---
// src/pages/index.astro
import { Image } from 'astro:assets'; 
import heroImage from '@/assets/hero-speaking.jpg';

import Layout from '../layouts/Layout.astro'; // Import the layout
import BookingWidget from '../components/BookingWidget.astro';
import KeyExpertise from '../components/KeyExpertise.astro';
import SpeakingEngagements from '../components/SpeakingEngagements.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
---

<Layout title="Ryan A. Moore | Portfolio" description="Welcome to the website and portfolio of Ryan A. Moore. Senior Strategy & Innovation Leader | Applying AI & Data Science to Solve Global Challenges | MCC | TechnoServe | Peace Corps Ecuador | Harvard | Purdue.  Data which Drives Impactful Teams. Looking ahead and using the power of evidence and foresight to help future-proof projects and organizations. Experienced Senior Leadership. Refined a large team’s excellence in delivery, from global recruiting and budgeting to program development and onboarding. Strategy & Strategic Planning. Collaborating across boundaries and borders to maximize organizational cohesion and real-world impact.">
 
  <section class="bg-gradient-to-br from-brand-sand via-white to-white">
    <div class="container mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <!-- Left Column: Image -->
      <div>
        <Image 
          src={heroImage} 
          alt="Ryan A. Moore speaking on a panel about international development"
          class="rounded-lg shadow-2xl"
        />
      </div>
      <!-- Right Column: Text -->
      <div class="text-center md:text-left">
        <h1 class="text-5xl lg:text-6xl font-serif font-bold text-brand-slate leading-tight">Ryan A. Moore</h1>
        <p class="text-xl text-brand-slate mt-4">
          Senior Strategy & Innovation Leader | Applying AI & Data Science to Solve Global Challenges | MCC | TechnoServe | Peace Corps Ecuador | Harvard | Purdue
      </p>
      </div>
    </div>
  </section>
  <KeyExpertise />
  <FeaturedProjects />
  <SpeakingEngagements />
  <BookingWidget />

</Layout>