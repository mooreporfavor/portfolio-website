---
// src/pages/cv.astro
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import AIBioGenerator from '../components/AIBioGenerator.astro';
import { tnfaUrl } from '../utils/utm';

const executiveRoles = [
  {
    role: "Vice President of Policy Innovation",
    org: "The New Foreign Assistance (TNFA)",
    orgUrl: tnfaUrl('cv-experience-org_card'),
    period: "Oct 2026 — Present",
    isCurrent: true,
    highlights: [
      "Directs policy innovation and statutory design for a modern U.S. economic statecraft architecture—integrating Sovereign Growth Compacts (MCC), Commercial De-Risking & Blended Finance (DFC), and Pay-for-Outcomes delivery.",
      "Leads program cycle design, procurement reform blueprints, and empirical growth diagnostics to lift binding constraints to private investment and crowd in commercial capital."
    ]
  },
  {
    role: "Division Chief, Strategy & Data | Chief of Operations",
    org: "United States Peace Corps",
    period: "2023 — Oct 2026",
    isCurrent: false,
    highlights: [
      "Architected 'Mission Control' Python/Streamlit analytics platform across 60+ country posts and directed agency-wide strategic planning and data governance.",
      "Led a 40-person global team and $10M+ annual budget as Chief of Operations, doubling volunteer delivery (300+ placed) in 9 months."
    ]
  },
  {
    role: "Director, Evaluation & Labor Markets | Associate Director, M&E",
    org: "Millennium Challenge Corporation (MCC)",
    period: "2012 — 2023",
    isCurrent: false,
    highlights: [
      "Directed 25+ rigorous causal evaluations ($1.4B+ sovereign infrastructure, energy, and TVET portfolios) and co-founded the Morocco Employment Lab with Harvard EPoD & MIT J-PAL.",
      "Structured MCC's first $30M Results-Based Financing (RBF) mechanism and joint MCC-IFC blended finance facilities."
    ]
  }
];

const competencies = [
  {
    category: "Executive & Strategic Leadership",
    skills: ["Multi-Million Portfolio Governance", "Cross-Functional & Global Team Leadership", "Strategic Planning & OKRs", "High-Stakes Government & Legislative Advisory"]
  },
  {
    category: "Econometrics & Rigorous Evaluation",
    skills: ["Growth Diagnostics (HRV Framework)", "Randomized Controlled Trials (RCTs)", "Cost-Benefit & Economic Rate of Return (ERR)", "TVET & Workforce Analytics"]
  },
  {
    category: "Innovative Finance & Economic Statecraft",
    skills: ["Results-Based Financing (RBF)", "Commercial De-Risking & Blended Finance", "Sovereign Compact Structuring", "Public-Private Partnerships (PPPs)"]
  },
  {
    category: "AI & Data Engineering",
    skills: ["Generative AI & LLM Policy Copilots", "Modern Data Platform Architecture", "Interactive Analytics & BI (Python/Streamlit)", "Master Data Vault Systems"]
  }
];
---

<Layout 
  title="Curriculum Vitae & Credentials | Ryan A. Moore" 
  description="Executive curriculum vitae, career experience, education, and competencies of Ryan A. Moore — Vice President of Policy Innovation at The New Foreign Assistance (TNFA)."
>
  <div class="py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top CV Hero Header -->
      <div class="max-w-4xl mx-auto text-center mb-16" data-animate-on-scroll>
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-blue-50 text-brand-blue border border-blue-200/80 text-xs font-bold uppercase tracking-wider mb-4">
          Verified Credentials
        </div>
        <h1 class="text-4xl sm:text-5xl font-serif font-bold text-brand-slate tracking-tight">
          Curriculum Vitae &amp; Experience
        </h1>
        <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed max-w-2xl mx-auto">
          Over 20 years driving strategy, evidence-based economic policy, and technology innovation across global institutions.
        </p>

        <!-- Download Action Card -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/Ryan-Moore-CV.pdf" 
            download
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-brand-blue hover:bg-blue-800 text-white font-semibold shadow-lg shadow-blue-900/20 hover:shadow-xl transition-all duration-300 hover:scale-102 group"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Download Official CV (PDF)</span>
          </a>

          <a 
            href="/cv-genie" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full bg-white hover:bg-slate-50 text-slate-800 font-semibold border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300"
          >
            <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Tailor CV with AI Genie</span>
          </a>
        </div>
      </div>

      <!-- Core Competencies & Executive Experience Matrix -->
      <div class="max-w-4xl mx-auto mb-16 space-y-10" data-animate-on-scroll>

        <!-- Executive Leadership Roles -->
        <div class="glass-panel p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-lg">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-8">
            <h2 class="text-2xl font-serif font-bold text-brand-slate">
              Executive Leadership &amp; Experience
            </h2>
            <a href="/bio" class="text-xs font-bold text-brand-blue hover:underline">
              View Full Career Timeline &rarr;
            </a>
          </div>

          <div class="space-y-5">
            {executiveRoles.map(item => (
              <div class:list={[
                "p-6 rounded-2xl border transition-all",
                item.isCurrent
                  ? "bg-gradient-to-r from-blue-50/50 via-white to-white border-blue-200 border-l-4 border-l-brand-accent shadow-xs"
                  : "bg-slate-50/80 border-slate-200/80"
              ]}>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-base sm:text-lg font-serif font-bold text-brand-slate">{item.role}</h3>
                    {item.isCurrent && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        Current
                      </span>
                    )}
                  </div>
                  <span class="text-xs font-mono font-bold text-brand-blue bg-white px-2.5 py-1 rounded-full border border-slate-200 w-fit">
                    {item.period}
                  </span>
                </div>
                {item.orgUrl ? (
                  <a
                    href={item.orgUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs font-bold text-brand-accent hover:text-brand-blue uppercase tracking-wide mb-3 hover:underline transition-colors"
                  >
                    <span>{item.org}</span>
                    <span>&nearr;</span>
                  </a>
                ) : (
                  <p class="text-xs font-bold text-brand-accent uppercase tracking-wide mb-3">{item.org}</p>
                )}
                <ul class="space-y-1.5">
                  {item.highlights.map(h => (
                    <li class="flex items-start text-xs sm:text-sm text-slate-600 leading-relaxed">
                      <span class="w-1.5 h-1.5 rounded-full bg-brand-accent mt-2 mr-2.5 flex-shrink-0"></span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <!-- Competencies & Education -->
        <div class="glass-panel p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-lg">
          <h2 class="text-2xl font-serif font-bold text-brand-slate mb-8 text-center sm:text-left">
            Core Competencies &amp; Capabilities
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            {competencies.map(comp => (
              <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80">
                <h3 class="text-sm font-bold uppercase tracking-wider text-brand-blue mb-4 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
                  {comp.category}
                </h3>
                <ul class="space-y-2.5">
                  {comp.skills.map(s => (
                    <li class="flex items-center text-xs font-medium text-slate-700">
                      <svg class="w-4 h-4 text-emerald-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.052-.143z" clip-rule="evenodd" />
                      </svg>
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <!-- Education Section -->
          <div class="mt-8 pt-8 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="p-5 rounded-2xl bg-white border border-slate-200">
              <span class="text-xs font-bold text-brand-accent uppercase tracking-wide">Graduate Degree</span>
              <h4 class="text-base font-serif font-bold text-brand-slate mt-1">Master in Public Administration (MPA/ID)</h4>
              <p class="text-xs text-slate-600 mt-0.5">Harvard University, John F. Kennedy School of Government</p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200">
              <span class="text-xs font-bold text-brand-accent uppercase tracking-wide">Undergraduate Degree</span>
              <h4 class="text-base font-serif font-bold text-brand-slate mt-1">Bachelor of Science</h4>
              <p class="text-xs text-slate-600 mt-0.5">Purdue University</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Interactive AI Copilot Section -->
      <AIBioGenerator 
        title="Interactive AI CV & Bio Generator" 
        descriptionHtml="Generate customized executive profiles on the fly using AI grounded <strong>only</strong> in verified master CV data. Test executive personas or paste your company's role requirements below." 
      />

      <!-- Socials -->
      <SocialLinks />

    </div>
  </div>
</Layout>
