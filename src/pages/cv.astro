---
// src/pages/cv.astro
import Layout from '../layouts/Layout.astro'
import SocialLinks from '../components/SocialLinks.astro';
import AIBioGenerator from '../components/AIBioGenerator.astro';
---

<Layout title="CV | Ryan A. Moore" description="Ryan Moore's Curriculum Vitae/Resume. For a detailed overview of my professional experience, skills, and accomplishments, please download my full CV.">
  <div class="bg-white py-16">
    <div class="container mx-auto px-6 text-center">
      <div class="max-w-2xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Curriculum Vitae</h1>
        <p class="text-lg text-gray-600 mb-8">
          For a detailed overview of my professional experience, skills, and accomplishments, please download my full CV.
        </p>
        <a 
          href="/Ryan-Moore-CV.pdf" 
          download
          class="inline-block bg-blue-600 text-white font-bold py-3 px-8 rounded-lg shadow-lg transition-transform duration-300 transform hover:scale-105"
        >
          Download CV (PDF)
        </a>
      </div>
    </div>
  </div>

  <AIBioGenerator 
    title="Interactive AI CV Generator" 
    descriptionHtml="Welcome. This tool generates my professional summary using AI, grounded <strong>only</strong> in my real CV. The buttons below generate comical versions, but you can use the text box to generate a real-life profile for roles like <strong>Chief Operating Officer</strong>, <strong>Chief Innovation Officer</strong>, or <strong>Data & AI Transformation Director</strong>." 
  />
  <SocialLinks />
</Layout>