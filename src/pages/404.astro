---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import fourohfour from '../assets/404.webp';
import { Image } from 'astro:assets';
---

<Layout title="404: Page Not Found | Ryan A. Moore">
  <div class="py-20 md:py-32">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-xl mx-auto glass-panel p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-xl">
        
        <div class="flex justify-center mb-6">
          <Image 
            src={fourohfour} 
            alt="404 Page Not Found" 
            class="h-40 w-40 rounded-2xl object-cover shadow-lg border border-slate-100 ring-2 ring-slate-100"
          />
        </div>

        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 text-red-700 text-xs font-bold uppercase tracking-wider mb-4">
          Error 404
        </div>

        <h1 class="text-3xl font-serif font-bold text-brand-slate mb-3">Page Not Found</h1>

        <p class="text-sm text-slate-600 mb-8 leading-relaxed">
          The page or case study you are looking for doesn't exist, has moved, or is currently undergoing maintenance.
        </p>

        <a 
          href="/" 
          class="inline-flex items-center gap-2 bg-brand-blue text-white font-semibold py-3 px-8 rounded-full shadow-lg shadow-blue-900/20 hover:bg-blue-800 transition-all duration-300 hover:scale-105"
        >
          <span>&larr; Return to Homepage</span>
        </a>

      </div>
    </div>
  </div>
</Layout>
