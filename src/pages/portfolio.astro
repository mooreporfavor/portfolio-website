---
// src/pages/portfolio.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PhotoReel from '../components/PhotoReel.astro';
import SectorExpertise from '../components/SectorExpertise.astro';
import AdvancedPortfolioFilter from '../components/AdvancedPortfolioFilter.jsx';

// This fetches all files from src/content/projects
const allProjects = await getCollection('projects');
---

<Layout title="Portfolio | Ryan A. Moore" description="Welcome to the project portfolio of Ryan A. Moore. Senior Strategy & Innovation Leader | Applying AI & Data Science to Solve Global Challenges | MCC | TechnoServe | Peace Corps Ecuador | Harvard | Purdue; data, evidence, infrastructure;Solutions;Education;Labor Markets;Water and Sanitation;Results-based Financing;Transport;Private Sector;Agriculture">
  <div class="bg-white py-16">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-serif font-bold text-brand-slate mb-12 text-center">Project Portfolio</h1>
      <SectorExpertise />
      <div class="mt-16">
        <AdvancedPortfolioFilter client:load projects={allProjects} />
      </div>
    <PhotoReel />
    </div>
  </div>
</Layout>