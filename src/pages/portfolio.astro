---
// src/pages/portfolio.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PhotoReel from '../components/PhotoReel.astro';
import SectorExpertise from '../components/SectorExpertise.astro';
import AdvancedPortfolioFilter from '../components/AdvancedPortfolioFilter.jsx';

// Fetch all project markdown files
const allProjects = await getCollection('projects');
---

<Layout 
  title="Project Portfolio & Case Studies | Ryan A. Moore" 
  description="Explore the case studies and project portfolio of Ryan A. Moore across Global Development, Applied AI & Data Engineering, and Senior Leadership."
>
  <div class="py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Portfolio Hero Header -->
      <div class="text-center max-w-3xl mx-auto mb-16" data-animate-on-scroll>
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-blue-50 text-brand-blue border border-blue-200/80 text-xs font-bold uppercase tracking-wider mb-4">
          Interactive Case Archive
        </div>
        <h1 class="text-4xl sm:text-5xl font-serif font-bold text-brand-slate tracking-tight">
          Project Portfolio & Research
        </h1>
        <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
          Comprehensive evaluations, strategic blueprints, and machine learning copilots developed for governments, multilaterals, and high-growth initiatives.
        </p>
      </div>

      <!-- Sector Matrix -->
      <SectorExpertise />

      <!-- Interactive Filter & Project Grid -->
      <div class="mt-12 mb-24">
        <AdvancedPortfolioFilter client:load projects={allProjects} />
      </div>

      <!-- Field Photo Reel -->
      <PhotoReel />

    </div>
  </div>
</Layout>