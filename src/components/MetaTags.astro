---
// src/components/MetaTags.astro
import defaultOgImage from '../assets/hero-speaking.jpg'; // A good default share image

// Workaround for a stubborn type resolution issue.
// Define a local type that matches the expected shape of ImageMetadata.
type LocalImageMetadata = {
  src: string;
  width: number;
  height: number;
  format: 'png' | 'jpg' | 'jpeg' | 'tiff' | 'webp' | 'gif' | 'svg' | 'avif';
}

export interface Props {
  title?: string;
  description?: string;
  ogImage?: LocalImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = "Ryan A. Moore | Global Development, AI & Data";
const siteDescription = "The professional portfolio of Ryan A. Moore, showcasing experience in international development, economics, and data analysis.";

const { title, description, ogImage } = Astro.props;

// Avoid duplicating Ryan's name if the page title already includes it
const displayTitle = title 
  ? (title.includes("Ryan") ? title : `${title} | Ryan A. Moore`)
  : siteTitle;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#1a202c">

<title>{displayTitle}</title>
<meta name="description" content={description ?? siteDescription} />

{/* Open Graph / LinkedIn / Facebook */}
<meta property="og:title" content={displayTitle} />
<meta property="og:description" content={description ?? siteDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={new URL(ogImage?.src ?? defaultOgImage.src, Astro.site)} />
<meta property="og:type" content="website" />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={displayTitle} />
<meta name="twitter:description" content={description ?? siteDescription} />
<meta name="twitter:image" content={new URL(ogImage?.src ?? defaultOgImage.src, Astro.site)} />