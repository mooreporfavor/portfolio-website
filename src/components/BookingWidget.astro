---
// src/components/BookingWidget.astro
---

<section class="py-24 bg-white relative overflow-hidden" data-animate-on-scroll>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      
      <!-- Card Container -->
      <div class="glass-panel p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-xl relative overflow-hidden">
        
        <!-- Header -->
        <div class="text-center max-w-2xl mx-auto mb-10">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-brand-blue text-xs font-bold uppercase tracking-wider mb-3">
            Get In Touch
          </div>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-brand-slate tracking-tight">
            Let's Collaborate & Innovate
          </h2>
          <p class="mt-3 text-slate-600 text-base leading-relaxed">
            Whether you are exploring executive advisory, AI-enabled evaluation pipelines, or speaking engagements, schedule a direct conversation on my calendar.
          </p>
        </div>

        <!-- Direct Connect Quick Actions -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <a 
            href="mailto:mooreporfavor@gmail.com" 
            class="flex items-center gap-3.5 p-4 rounded-xl bg-slate-50 hover:bg-blue-50/80 border border-slate-200/80 hover:border-blue-300 transition-all group"
          >
            <div class="w-10 h-10 rounded-lg bg-blue-600/10 text-brand-accent flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Direct Email</p>
              <p class="text-sm font-semibold text-brand-slate group-hover:text-brand-blue transition-colors">mooreporfavor@gmail.com</p>
            </div>
          </a>

          <a 
            href="https://www.linkedin.com/in/mooreporfavor/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center gap-3.5 p-4 rounded-xl bg-slate-50 hover:bg-blue-50/80 border border-slate-200/80 hover:border-blue-300 transition-all group"
          >
            <div class="w-10 h-10 rounded-lg bg-blue-600/10 text-brand-accent flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">LinkedIn Network</p>
              <p class="text-sm font-semibold text-brand-slate group-hover:text-brand-blue transition-colors">linkedin.com/in/mooreporfavor</p>
            </div>
          </a>
        </div>

        <!-- Embedded Microsoft Bookings Calendar -->
        <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-inner p-1">
          <div class='sk-ww-microsoft-bookings' data-embed-id='25608409'></div>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- Sociablekit widget script -->
<script src='https://widgets.sociablekit.com/microsoft-bookings/widget.js' is:inline defer></script>