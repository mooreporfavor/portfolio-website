---
// src/components/Header.astro

// This gets the current page's URL path, e.g., "/about" or "/portfolio"
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/bio", text: "Bio" },
  { href: "/portfolio", text: "Portfolio" },
  { href: "/socials", text: "Socials" },
  { href: "/cv", text: "CV" },
];
---
<header class="sticky top-0 z-50 w-full bg-brand-sand/75 backdrop-blur-lg border-b border-black/[0.04] shadow-[0_2px_20px_rgba(0,0,0,0.02)]">
  <nav class="container mx-auto px-6 py-3 flex justify-between items-center">
    
    <!-- Left Side: Your Name/Logo -->
    <div>
      <a href="/" class="text-2xl font-serif font-bold text-brand-slate hover:text-brand-blue transition-colors duration-300">
        Ryan A. Moore
      </a>
      <p class="text-sm font-sans text-brand-gray">Global Development, AI & Data</p>
    </div>
    
    <!-- Right Side: The New "Pill" Navigation -->
    <div class="flex items-center space-x-2 rounded-full bg-white shadow-sm p-1">
      {navLinks.map(link => {
        const isActive = currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              "relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-300 ease-in-out",
              "focus:outline-none focus:ring-2 focus:ring-brand-blue focus:ring-offset-2",
              {
                'bg-brand-blue text-white shadow-md': isActive,
                'text-brand-slate hover:bg-black/[0.04]': !isActive
              }
            ]}
          >
            {link.text}
            {isActive && (
              <span class="absolute -bottom-1 left-1/2 w-1/2 h-0.5 bg-brand-blue transform -translate-x-1/2"></span>
            )}
          </a>
        )
      })}
    </div>
  </nav>
</header>