---
// src/components/Languages.astro
const languages = [
  { 
    name: "English", 
    level: "Native Proficiency", 
    badge: "Native",
    svg: "usa"
  },
  { 
    name: "Spanish", 
    level: "Fluent / Bilingual", 
    badge: "Bilingual",
    svg: "spain"
  },
  { 
    name: "Portuguese", 
    level: "Proficient (European Portuguese)", 
    badge: "Proficient",
    svg: "portugal"
  },
  { 
    name: "French", 
    level: "Proficient", 
    badge: "Proficient",
    svg: "france"
  },
];
---

<div class="mt-16 pt-10 border-t border-slate-100" data-animate-on-scroll>
  <div class="flex items-center gap-2 mb-6">
    <div class="w-8 h-8 rounded-lg bg-blue-50 text-brand-blue flex items-center justify-center">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
      </svg>
    </div>
    <h3 class="text-xl font-serif font-bold text-brand-slate">Languages & Cross-Cultural Fluency</h3>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {languages.map(lang => (
      <div class="p-5 rounded-2xl bg-slate-50/90 border border-slate-200/80 hover:bg-blue-50/50 hover:border-blue-200 transition-all duration-200 group flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <!-- Vector SVG Flags for crisp, universal rendering across all OS/browsers -->
            {lang.svg === "usa" && (
              <svg class="w-8 h-5 rounded shadow-xs border border-slate-200/60 overflow-hidden" viewBox="0 0 741 390">
                <rect width="741" height="390" fill="#B22234"/>
                <path d="M0,30H741M0,90H741M0,150H741M0,210H741M0,270H741M0,330H741" stroke="#fff" stroke-width="30"/>
                <rect width="296" height="210" fill="#3C3B6E"/>
                <g fill="#fff" opacity="0.95">
                  <circle cx="35" cy="30" r="10"/><circle cx="95" cy="30" r="10"/><circle cx="155" cy="30" r="10"/><circle cx="215" cy="30" r="10"/><circle cx="270" cy="30" r="10"/>
                  <circle cx="65" cy="70" r="10"/><circle cx="125" cy="70" r="10"/><circle cx="185" cy="70" r="10"/><circle cx="245" cy="70" r="10"/>
                  <circle cx="35" cy="110" r="10"/><circle cx="95" cy="110" r="10"/><circle cx="155" cy="110" r="10"/><circle cx="215" cy="110" r="10"/><circle cx="270" cy="110" r="10"/>
                  <circle cx="65" cy="150" r="10"/><circle cx="125" cy="150" r="10"/><circle cx="185" cy="150" r="10"/><circle cx="245" cy="150" r="10"/>
                  <circle cx="35" cy="190" r="10"/><circle cx="95" cy="190" r="10"/><circle cx="155" cy="190" r="10"/><circle cx="215" cy="190" r="10"/><circle cx="270" cy="190" r="10"/>
                </g>
              </svg>
            )}

            {lang.svg === "spain" && (
              <svg class="w-8 h-5 rounded shadow-xs border border-slate-200/60 overflow-hidden" viewBox="0 0 750 500">
                <rect width="750" height="500" fill="#AA151B"/>
                <rect y="125" width="750" height="250" fill="#F1BF00"/>
                <circle cx="200" cy="250" r="45" fill="#AA151B" opacity="0.85"/>
                <rect x="190" y="225" width="20" height="50" fill="#F1BF00"/>
              </svg>
            )}

            {lang.svg === "portugal" && (
              <svg class="w-8 h-5 rounded shadow-xs border border-slate-200/60 overflow-hidden" viewBox="0 0 600 400">
                <rect width="240" height="400" fill="#046A38"/>
                <rect x="240" width="360" height="400" fill="#DA291C"/>
                <circle cx="240" cy="200" r="60" fill="#FFC400"/>
                <circle cx="240" cy="200" r="45" fill="#046A38" opacity="0.15"/>
                <rect x="225" y="175" width="30" height="45" rx="8" fill="#FFFFFF"/>
                <rect x="230" y="180" width="20" height="35" rx="5" fill="#DA291C"/>
                <rect x="235" y="188" width="10" height="15" fill="#002B7F"/>
              </svg>
            )}

            {lang.svg === "france" && (
              <svg class="w-8 h-5 rounded shadow-xs border border-slate-200/60 overflow-hidden" viewBox="0 0 900 600">
                <rect width="300" height="600" fill="#002654"/>
                <rect x="300" width="300" height="600" fill="#FFFFFF"/>
                <rect x="600" width="300" height="600" fill="#CE1126"/>
              </svg>
            )}

            <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-slate-700 shadow-2xs">
              {lang.badge}
            </span>
          </div>

          <p class="text-sm font-bold text-brand-slate group-hover:text-brand-blue transition-colors">
            {lang.name}
          </p>
          <p class="text-xs text-slate-500 mt-1 leading-snug">
            {lang.level}
          </p>
        </div>
      </div>
    ))}
  </div>
</div>