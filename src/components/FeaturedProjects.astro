---
// src/components/FeaturedProjects.astro
import { getCollection } from 'astro:content';

const featuredProjects = await getCollection('projects', ({ data }) => {
  return data.isFeatured === true;
});

const projectsWithPlainText = featuredProjects.map(project => {
    const plainBody = project.body
        .replace(/<[^>]*>?/gm, '') // remove html tags
        .replace(/[#*`[\]()]/g, '') // remove markdown
        .replace(/\s+/g, ' ') // collapse whitespace
        .trim();
    return { ...project, plainBody };
});

const getTrackBadge = (track: string) => {
  switch(track) {
    case 'Global Development':
      return 'bg-emerald-950/80 text-emerald-300 border-emerald-800/80';
    case 'Data Engineering & AI':
      return 'bg-blue-950/80 text-blue-300 border-blue-800/80';
    case 'Leadership':
      return 'bg-amber-950/80 text-amber-300 border-amber-800/80';
    default:
      return 'bg-slate-800 text-slate-300 border-slate-700';
  }
};
---

<section class="py-24 bg-brand-navy text-white relative overflow-hidden" data-animate-on-scroll>
  <!-- Ambient background glow -->
  <div class="absolute top-1/3 left-1/4 w-96 h-96 bg-brand-blue/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 right-1/4 w-96 h-96 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-950/80 border border-blue-800/80 text-blue-300 text-xs font-bold uppercase tracking-wider mb-3">
          Evidence In Action
        </div>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white tracking-tight">
          Featured Projects & Case Studies
        </h2>
        <p class="mt-3 text-base text-slate-400 max-w-xl">
          Deep dives into high-stakes policy evaluations, custom AI implementations, and organizational restructuring.
        </p>
      </div>

      <a 
        href="/portfolio" 
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white text-sm font-semibold border border-white/20 backdrop-blur-md transition-all duration-300 hover:scale-105"
      >
        <span>View Full Portfolio ({featuredProjects.length}+)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsWithPlainText.map(project => (
        <a 
          href={`/portfolio/${project.slug}/`} 
          class="group relative bg-slate-900/90 hover:bg-slate-800/90 p-7 rounded-2xl border border-slate-800 hover:border-blue-500/50 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between"
        >
          <div>
            <!-- Top Badges -->
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
              <span class={`text-xs font-semibold px-2.5 py-0.5 rounded-full border ${getTrackBadge(project.data.track)}`}>
                {project.data.track}
              </span>
              <span class="text-xs text-slate-400 font-mono">
                {project.data.year}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-serif font-bold text-white group-hover:text-blue-400 transition-colors line-clamp-2 mb-2">
              {project.data.title}
            </h3>

            <!-- Client -->
            <p class="text-xs font-semibold text-blue-400 uppercase tracking-wide mb-4">
              {project.data.client}
            </p>

            <!-- Excerpt -->
            <p class="text-slate-300 text-sm leading-relaxed line-clamp-3 mb-6 font-normal">
              {project.plainBody.slice(0, 160)}...
            </p>
          </div>

          <!-- Footer of Card: Tags & Arrow CTA -->
          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <div class="flex flex-wrap gap-1.5 max-w-[70%]">
              {project.data.tags.slice(0, 2).map((tag: string) => (
                <span class="bg-slate-800 text-slate-300 text-[11px] font-medium px-2 py-0.5 rounded-md">
                  {tag}
                </span>
              ))}
            </div>

            <span class="text-xs font-bold text-blue-400 group-hover:text-blue-300 flex items-center gap-1">
              Read Study
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>

        </a>
      ))}
    </div>

    <!-- Bottom Mobile CTA -->
    <div class="text-center mt-12 md:hidden">
      <a 
        href="/portfolio" 
        class="inline-flex items-center gap-2 bg-blue-600 text-white font-semibold py-3 px-8 rounded-full shadow-lg"
      >
        <span>View All Projects</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

  </div>
</section>