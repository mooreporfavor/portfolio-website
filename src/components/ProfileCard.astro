---
// src/components/ProfileCard.astro
export interface Props {
  name: string;
  title: string;
  imageUrl: string;
  profileUrl: string;
  count: number;
}

const { name, title, imageUrl, profileUrl, count } = Astro.props;
---

<div class="group bg-white rounded-2xl p-6 border border-slate-200/80 shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between">
  <div>
    <!-- Top Row: Avatar & Count Badge -->
    <div class="flex items-start justify-between gap-4 mb-4">
      <div class="relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-brand-accent to-blue-400 rounded-full blur-xs opacity-0 group-hover:opacity-60 transition-opacity"></div>
        <img 
          class="relative h-14 w-14 rounded-full object-cover ring-2 ring-slate-100 shadow-sm" 
          src={imageUrl} 
          alt={`Profile picture of ${name}`} 
          loading="lazy"
        />
      </div>

      <span class="inline-flex items-center gap-1 text-[11px] font-mono font-bold px-2.5 py-1 rounded-full bg-blue-50 text-brand-blue border border-blue-200/60 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-accent animate-pulse"></span>
        {count} Interactions
      </span>
    </div>

    <!-- Details -->
    <h3 class="text-base font-serif font-bold text-brand-slate group-hover:text-brand-accent transition-colors">
      {name}
    </h3>
    <p class="text-xs text-slate-600 line-clamp-2 mt-1 leading-relaxed">
      {title}
    </p>
  </div>

  <!-- Bottom CTA -->
  <div class="mt-5 pt-3.5 border-t border-slate-100 flex items-center justify-between">
    <span class="text-[11px] font-semibold text-slate-400">LinkedIn Colleague</span>
    <a 
      href={profileUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center gap-1 text-xs font-bold text-brand-blue hover:text-blue-800 transition-colors"
    >
      <span>View Profile</span>
      <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</div>