---
// src/components/SocialProfileCard.astro
export interface Props {
  platform: 'linkedin' | 'facebook' | 'twitter';
  name: string;
  title: string;
  imageUrl: string;
  profileUrl: string;
}

const { platform, name, title, imageUrl, profileUrl } = Astro.props;

const platformConfig = {
  linkedin: {
    label: "Connect on LinkedIn",
    color: "bg-[#0A66C2] hover:bg-[#004182]",
    textColor: "text-[#0A66C2]",
    badgeBg: "bg-blue-50 border-blue-200/80",
    name: "LinkedIn"
  },
  twitter: {
    label: "Follow on X / Twitter",
    color: "bg-black hover:bg-slate-800",
    textColor: "text-black",
    badgeBg: "bg-slate-100 border-slate-200",
    name: "X (Twitter)"
  },
  facebook: {
    label: "Connect on Facebook",
    color: "bg-[#1877F2] hover:bg-[#0d65d9]",
    textColor: "text-[#1877F2]",
    badgeBg: "bg-blue-50 border-blue-200/80",
    name: "Facebook"
  }
};

const config = platformConfig[platform];
---

<div class="group bg-white rounded-2xl p-6 border border-slate-200/80 shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1.5 w-full max-w-sm flex flex-col justify-between">
  <div>
    <!-- Header -->
    <div class="flex items-center space-x-4 mb-4">
      <div class="relative">
        <img 
          class="h-16 w-16 rounded-full object-cover ring-2 ring-slate-100 shadow-sm" 
          src={imageUrl} 
          alt={`Profile picture of ${name}`} 
        />
      </div>
      <div class="flex-1">
        <div class="flex items-center justify-between">
          <p class="text-base font-serif font-bold text-brand-slate">{name}</p>
          <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full border ${config.badgeBg} ${config.textColor}`}>
            {config.name}
          </span>
        </div>
        <p class="text-xs text-slate-500 line-clamp-2 mt-0.5 leading-relaxed">{title}</p>
      </div>
    </div>
  </div>

  <a 
    href={profileUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class={`flex items-center justify-center w-full px-4 py-2.5 rounded-xl text-xs font-semibold text-white shadow-sm transition-all duration-200 hover:shadow-md ${config.color}`}
  >
    {platform === 'linkedin' && (
      <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 114.75 6.5 1.75 1.75 0 016.5 8.25zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"></path></svg>
    )}
    {platform === 'facebook' && (
      <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path></svg>
    )}
    {platform === 'twitter' && (
      <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M16.9999 0H20.9999L14.6689 7.38683L22.9999 16H14.9999L9.61891 9.01171L3.99991 16H0L6.83891 8.03856L-0.000100136 0H8.0009L12.8429 6.48865L16.9999 0ZM15.8239 14.4267H17.2239L5.42391 1.57211H3.91191L15.8239 14.4267Z"></path></svg>
    )}
    <span>{config.label}</span>
  </a>
</div>