---
// src/components/SocialLinks.astro
import SocialProfileCard from './SocialProfileCard.astro';
import linkedinImg from '../assets/ryan_socials/linkedin.png';
import facebookImg from '../assets/ryan_socials/facebook.jpg';
import twitterImg from '../assets/ryan_socials/twitter.jpg';
---

<section class="py-16 md:py-24" data-animate-on-scroll>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-brand-blue text-xs font-bold uppercase tracking-wider mb-3">
        Social Hub
      </div>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-brand-slate tracking-tight">
        Connect & Follow
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base">
        Join the conversation on professional networks, ongoing research, and personal updates.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      
      <!-- LinkedIn Badge -->
      <SocialProfileCard
        platform="linkedin"
        name="Ryan A. Moore"
        title="Senior Strategy & Innovation Leader | Applying AI & Data Science to Solve Global Challenges"
        profileUrl="https://www.linkedin.com/in/mooreporfavor/"
        imageUrl={linkedinImg.src}
      />

      <!-- Facebook Badge -->
      <SocialProfileCard
        platform="facebook"
        name="Ryan A. Moore"
        title="Personal updates, travel logs, and community adventures."
        profileUrl="https://www.facebook.com/Mooreporfavor"
        imageUrl={facebookImg.src}
      />

      <!-- Twitter/X Badge -->
      <SocialProfileCard
        platform="twitter"
        name="Ryan A. Moore"
        title="Thoughts on AI tech, global economics, and Sevilla FC."
        profileUrl="https://x.com/mooreporfavor"
        imageUrl={twitterImg.src}
      />

    </div>
  </div>
</section>