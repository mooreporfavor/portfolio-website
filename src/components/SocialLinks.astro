---
// src/components/SocialLinks.astro
import SocialProfileCard from './SocialProfileCard.astro';
import linkedinImg from '../assets/ryan_socials/linkedin.png';
import facebookImg from '../assets/ryan_socials/facebook.jpg';
import twitterImg from '../assets/ryan_socials/twitter.jpg';
---
<section class="py-16" data-animate-on-scroll>
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-bold text-center text-gray-800 mb-12">Connect With Me</h2>
    <div class="flex flex-col md:flex-row flex-wrap justify-center items-center gap-8 md:gap-12">
      
      <!-- LinkedIn Badge -->
      <SocialProfileCard
        platform="linkedin"
        name="Ryan A. Moore"
        title="Senior Strategy & Innovation Leader | Applying AI & Data Science to Solve Global Challenges | MCC | TechnoServe | Peace Corps Ecuador | Harvard | Purdue"
        profileUrl="https://www.linkedin.com/in/mooreporfavor/"
        imageUrl={linkedinImg.src}
      />

      <!-- Facebook Badge -->
      <SocialProfileCard
        platform="facebook"
        name="Ryan A. Moore"
        title="Connect with me on Facebook for personal updates."
        profileUrl="https://www.facebook.com/Mooreporfavor"
        imageUrl={facebookImg.src}
      />
      <!-- Twitter Badge -->
      <SocialProfileCard
        platform="twitter"
        name="Ryan A. Moore"
        title="Connect with me on Twitter for personal updates."
        profileUrl="https://x.com/mooreporfavor"
        imageUrl={twitterImg.src}
      />

    </div>
  </div>
</section>