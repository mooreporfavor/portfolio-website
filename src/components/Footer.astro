---
// src/components/Footer.astro
import { Image } from 'astro:assets';
import monogram from '../assets/monogram.jpg';

const currentYear = new Date().getFullYear();
---
<footer class="bg-brand-slate text-brand-sand mt-16 border-t-4 border-gray-700">
  <div class="container mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm">

      <!-- Column 1: Brand & Copyright -->
      <div class="space-y-4">
        <h3 class="font-bold text-lg text-white font-serif">Ryan A. Moore</h3>
        <p class="text-brand-gray">&copy; {currentYear} All rights reserved.</p>
      </div>

      <!-- Column 2: Site Navigation -->
      <div>
        <h3 class="font-bold text-lg text-white mb-4 uppercase tracking-wider font-serif">Navigate</h3>
        <nav class="flex flex-col space-y-2">
          <a href="/" class="text-brand-sand hover:text-white hover:underline transition-colors duration-300">Home</a>
          <a href="/bio" class="text-brand-sand hover:text-white hover:underline transition-colors duration-300">Bio</a>
          <a href="/portfolio" class="text-brand-sand hover:text-white hover:underline transition-colors duration-300">Portfolio</a>
          <a href="/socials" class="text-brand-sand hover:text-white hover:underline transition-colors duration-300">Socials</a>
          <a href="/cv" class="text-brand-sand hover:text-white hover:underline transition-colors duration-300">CV</a>
        </nav>
      </div>

      <!-- Column 3: The Colophon with Monogram & GitHub Link -->
      <div>
        <div class="flex items-start gap-4">
          <Image src={monogram} alt="Ryan A. Moore Monogram" class="h-16 w-16 rounded-md flex-shrink-0" />
          <div class="flex-grow">
            <p class="mb-2 text-brand-sand">
              This site is a "meta" portfolio, built to both showcase my experience and my technical skills.
        </p>
        <div class="mb-4">
          <a 
            href="/portfolio/astro-tailwind-ryanamoore/" 
            class="font-semibold text-brand-sand hover:text-white hover:underline transition-colors duration-300"
          >
              Read the Case Study &rarr;
            </a>
            
            <!-- ▼▼▼ THIS IS THE NEW BLOCK ▼▼▼ -->
            <div class="mt-4 pt-4 border-t border-brand-gray flex items-center gap-4">
              <a href="https://github.com/mooreporfavor/portfolio-website" target="_blank" rel="noopener noreferrer" class="flex items-center text-brand-gray hover:text-brand-sand transition-colors duration-300">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.168 6.839 9.49.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.031-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.03 1.595 1.03 2.688 0 3.848-2.338 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.001 10.001 0 0022 12c0-5.523-4.477-10-10-10z" clip-rule="evenodd"></path>
                </svg>
                <span>View Codebase</span>
              </a>
            </div>
            <!-- ▲▲▲ END OF NEW BLOCK ▲▲▲ -->
            
          </div>
        </div>
      </div>

    </div>
  </div>
</footer>
