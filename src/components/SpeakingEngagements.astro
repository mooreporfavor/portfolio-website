---
// src/components/SpeakingEngagements.astro
import { Image } from 'astro:assets';
import imgSummit from '../assets/speaking-summit.jpg';
import imgCapeTown from '../assets/hero-speaking.jpg';
import imgMorocco from '../assets/speaking-morocco.webp';
import imgCpia from '../assets/speaking-cpia.png';
import { tnfaUrl, withUtm } from '../utils/utm';

const engagements = [
  {
    image: imgCpia,
    alt: "2026 CPIA Leadership Conference in Nashville",
    title: "2026 CPIA Leadership Conference",
    venue: "Nashville, Tennessee",
    topic: "Executive Strategy & Operational Leadership",
    url: withUtm("https://www.eventsquid.com/event.cfm?id=32025", { content: "home-speaking-cpia_2026" }),
    cta: "Conference Details",
    isVideo: false
  },
  {
    image: imgSummit,
    alt: "Speaking at the Global Youth Economic Opportunity Summit",
    title: "Global Youth Economic Opportunity Summit",
    venue: "Washington, D.C.",
    topic: "Youth Employment & TVET Impact",
    url: withUtm("https://www.youtube.com/watch?v=p9GkhTiLfSs", { content: "home-speaking-gyeo_summit" }),
    cta: "Watch Recording",
    isVideo: true
  },
  {
    image: imgCapeTown,
    alt: "Speaking at the Jobs4Development Conference in Cape Town",
    title: "Jobs4Development Conference",
    venue: "Cape Town, South Africa",
    topic: "Global Labor Markets & Evidence",
    url: withUtm("https://jobsanddevelopmentconference.org/conferences-list/2022-conference-2/", { content: "home-speaking-jobs4dev_2022" }),
    cta: "Conference Details",
    isVideo: false
  },
  {
    image: imgMorocco,
    alt: "Speaking at the International RBF Seminar in Morocco",
    title: "International RBF Seminar",
    venue: "Rabat, Morocco",
    topic: "Results-Based Financing & Social Bonds",
    url: withUtm("https://www.linkedin.com/posts/mooreporfavor_rbfseminar-mcamorocco-activity-7022441949273972736-5RD1/", { content: "home-speaking-rbf_seminar" }),
    cta: "View Highlights",
    isVideo: false
  }
];
---

<section class="py-24 bg-slate-50 relative overflow-hidden" data-animate-on-scroll>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-brand-blue text-xs font-bold uppercase tracking-wider mb-3">
        Thought Leadership &amp; Media
      </div>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-brand-slate tracking-tight">
        Speaking, Keynotes &amp; Podcasts
      </h2>
      <p class="mt-3 text-slate-600 text-base">
        Sharing rigorous research, operational strategies, and policy frameworks on global stages and podcasts.
      </p>
    </div>

    <!-- Featured Upcoming Podcast Banner -->
    <div class="max-w-7xl mx-auto mb-10">
      <div class="relative rounded-2xl overflow-hidden bg-gradient-to-r from-brand-navy via-slate-900 to-brand-blue text-white p-6 sm:p-8 border border-slate-800 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <!-- Ambient glow -->
        <div class="absolute -right-12 -top-12 w-64 h-64 bg-brand-accent/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex items-start sm:items-center gap-5 relative z-10">
          <!-- Microphone / Podcast Icon Tile -->
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-md flex items-center justify-center flex-shrink-0 shadow-inner">
            <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
            </svg>
          </div>

          <div class="space-y-1.5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-500/20 border border-amber-400/40 text-amber-300 text-[11px] font-bold uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Coming Soon
              </span>
              <span class="text-xs font-semibold text-blue-300 uppercase tracking-wide">
                Featured Podcast Guest
              </span>
            </div>

            <h3 class="text-xl sm:text-2xl font-serif font-bold text-white tracking-tight">
              &ldquo;The Pursuit of Purpose&rdquo; with Chris Kiefer
            </h3>

            <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
              Upcoming conversation exploring purpose-driven executive leadership, AI-native operations, and rebuilding the architecture of U.S. foreign assistance at <a href={tnfaUrl('home-podcast-inline_link')} target="_blank" rel="noopener noreferrer" class="font-bold text-white hover:text-amber-300 underline decoration-white/40 hover:decoration-amber-300 underline-offset-4 transition-colors">The New Foreign Assistance (TNFA)</a>.
            </p>
          </div>
        </div>

        <!-- Audio Waveform & Status Pill -->
        <div class="flex items-center gap-3 self-stretch md:self-center justify-between md:justify-end border-t md:border-t-0 border-white/10 pt-4 md:pt-0 relative z-10 flex-shrink-0">
          <div class="flex items-end gap-1 h-6 px-2" aria-hidden="true">
            <span class="w-1 h-2.5 bg-blue-400/70 rounded-full animate-pulse"></span>
            <span class="w-1 h-5 bg-amber-400/90 rounded-full animate-pulse"></span>
            <span class="w-1 h-3.5 bg-blue-300/80 rounded-full animate-pulse"></span>
            <span class="w-1 h-6 bg-amber-400 rounded-full animate-pulse"></span>
            <span class="w-1 h-3 bg-blue-400/70 rounded-full animate-pulse"></span>
          </div>
          <span class="px-4 py-2 rounded-full bg-white/10 border border-white/20 text-xs font-semibold text-slate-200 whitespace-nowrap">
            Episode Dropping Soon
          </span>
        </div>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
      {engagements.map(event => (
        <a 
          href={event.url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group block bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1.5"
        >
          <!-- Image with overlay -->
          <div class="relative h-56 overflow-hidden bg-slate-900">
            <Image 
              src={event.image} 
              alt={event.alt} 
              class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 opacity-90 group-hover:opacity-100" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>

            {/* Video or Venue Badge */}
            <div class="absolute top-3 left-3">
              <span class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-xs font-medium border border-white/20">
                {event.venue}
              </span>
            </div>

            {event.isVideo && (
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:bg-red-600 transition-all">
                  <svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </div>
            )}
          </div>

          <!-- Content Details -->
          <div class="p-6">
            <p class="text-xs font-semibold text-brand-accent uppercase tracking-wide mb-1">
              {event.topic}
            </p>
            <h3 class="text-lg font-serif font-bold text-brand-slate mb-4 group-hover:text-brand-blue transition-colors line-clamp-2">
              {event.title}
            </h3>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-slate-700">
              <span class="text-brand-blue group-hover:underline flex items-center gap-1">
                {event.cta} &rarr;
              </span>
              <svg class="w-4 h-4 text-slate-400 group-hover:text-brand-blue transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
