---
/// <reference types="astro/client" />
import { Image } from 'astro:assets';

// Workaround for a stubborn type resolution issue.
// Define a local type that matches the expected shape of ImageMetadata.
type LocalImageMetadata = {
  src: string;
  width: number;
  height: number;
  format: 'png' | 'jpg' | 'jpeg' | 'tiff' | 'webp' | 'gif' | 'svg' | 'avif';
}

const imageImports = import.meta.glob('@/assets/development/**/*.{jpg,jpeg,png,webp}');
const allImages = Object.values(imageImports);

const animationDuration = allImages.length * 1.5;
---
<section class="py-16">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-serif font-bold text-center text-brand-slate mb-4">Field Notes & Snapshots</h2>
    <p class="text-center text-brand-gray mb-10 max-w-2xl mx-auto">
      A glimpse into the people, places, and projects that have shaped my work.
    </p>
    <div class="w-full inline-flex flex-nowrap overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)]">
      <div class="flex-none flex items-center justify-center md:justify-start animate-infinite-scroll" style={`--duration: ${animationDuration}s`}>
        {allImages.map(async (imageLoader) => {
          const image = await imageLoader() as { default: LocalImageMetadata };
          return (
            <div class="flex-shrink-0 w-80 mx-4">
              <Image 
                src={image.default} 
                alt="A photo from a development project in the field"
                class="h-56 w-full object-cover rounded-lg shadow-md"
              />
            </div>
          );
        })}
      </div>
      <div class="flex-none flex items-center justify-center md:justify-start animate-infinite-scroll" style={`--duration: ${animationDuration}s`} aria-hidden="true">
        {allImages.map(async (imageLoader) => {
          const image = await imageLoader() as { default: LocalImageMetadata };
          return (
            <div class="flex-shrink-0 w-80 mx-4">
              <Image 
                src={image.default} 
                alt="A photo from a development project in the field"
                class="h-56 w-full object-cover rounded-lg shadow-md"
              />
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes infinite-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }
  .animate-infinite-scroll {
    animation: infinite-scroll var(--duration) linear infinite;
  }
  .animate-infinite-scroll:hover {
    animation-play-state: paused;
  }
</style>
